{
  "name": "foom-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^24.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check && tsc --noEmit",
    "serve": "astro preview",
    "lint": "eslint . --max-warnings 0 && pnpm format:check",
    "lint:fix": "prettier . --write && eslint . --fix --max-warnings 0",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
