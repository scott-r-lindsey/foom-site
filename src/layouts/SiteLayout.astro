---
import '../styles/global.css';
import favicon16 from '../assets/brand/favicon-16.png';
import favicon32 from '../assets/brand/favicon-32.png';
import appleTouch from '../assets/brand/apple-touch-icon.png';
import social from '../assets/brand/social.png';
import displayFont from '../assets/fonts/archivo-black.woff2?url';
import bodyFont from '../assets/fonts/geist.woff2?url';
import voiceFont from '../assets/fonts/courier-prime.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
}

const { title, description, noindex = false, canonicalPath } = Astro.props;
const pageTitle = title === 'foom' ? title : `${title} | foom`;
const canonical = new URL(
  canonicalPath ?? `${Astro.url.pathname.replace(/\/+$/, '')}/`,
  Astro.site,
);
const socialUrl = new URL(social.src, Astro.site).href;
const robots =
  noindex || import.meta.env.SITE_INDEXABLE !== 'true'
    ? 'noindex, nofollow'
    : 'index, follow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouch.src} />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={voiceFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="foom" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A violet black hole beside the foom wordmark."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialUrl} />
    <meta
      name="twitter:image:alt"
      content="A violet black hole beside the foom wordmark."
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href="/" aria-label="foom home">
          foom
        </a>
      </div>
    </header>
    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>foom · A terminal.</p>
      </div>
    </footer>
  </body>
</html>
